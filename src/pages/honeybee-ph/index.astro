---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Honeybee-PH | PH-Tools" activePage="honeybee-ph">
  <!-- Hero -->
  <section class="hero graph-paper">
    <h1>Honeybee<span class="accent">-</span>PH</h1>
    <p class="tagline">
      Passive House energy modeling in Rhino and Grasshopper. Add Passive House data to your Honeybee models
      and export to WUFI-Passive or PHPP.
    </p>
    <div class="hero-actions">
      <a href="/honeybee-ph/install/" class="btn btn-primary">Get Started</a>
      <a href="https://github.com/PH-Tools/honeybee_grasshopper_ph/releases/latest/download/hbph_installer.ghx" class="btn btn-primary">Download Installer</a>
      <a href="https://docs.passivehousetools.com/honeybee-ph/" class="btn btn-ghost" target="_blank">Documentation</a>
    </div>
  </section>

  <!-- Features -->
  <section class="features">
    <h2>Why Honeybee-PH?</h2>
    <div class="feature-grid">
      <div class="feature-item">
        <h3>Adds to existing workflows</h3>
        <p>Build on your existing Honeybee setup to produce models for Passive House design analysis and certification.</p>
      </div>
      <div class="feature-item">
        <h3>Single model</h3>
        <p>Work from one Rhino model across daylighting, annual energy, thermal comfort, and Passive House certification.</p>
      </div>
      <div class="feature-item">
        <h3>Stay in Grasshopper</h3>
        <p>Set up mechanical systems, space programs, and certification inputs right in Grasshopper.</p>
      </div>
      <div class="feature-item">
        <h3>Non-residential modeling</h3>
        <p>Tap into the Honeybee-Energy program library for non-residential buildings. Assign occupancy, lighting, and equipment schedules across dozens of zones without building them by hand.</p>
      </div>
      <div class="feature-item">
        <h3>Faster certification reporting</h3>
        <p>Automate schedules for envelope assemblies, thermal bridges, TFA/iCFA areas, and room-by-room ventilation airflows.</p>
      </div>
      <div class="feature-item">
        <h3>WUFI-Passive or PHPP</h3>
        <p>Export to PHPP v9/v10 or WUFI-Passive in English, Spanish, or German, using either SI or IP units.</p>
      </div>
    </div>
  </section>

  <!-- Getting Started -->
  <section class="getting-started">
    <h2>Getting started</h2>
    <p class="section-desc">Install the plugin, run your first export, or browse the tutorials.</p>
    <div class="card-grid">
      <a class="service-card" href="/honeybee-ph/install/">
        <div class="service-card__title">Install</div>
        <div class="service-card__subtitle">Download &amp; setup</div>
        <div class="service-card__body">Install Honeybee-PH and the Grasshopper components. Free and open-source.</div>
      </a>

      <a class="service-card" href="/honeybee-ph/quick-start/">
        <div class="service-card__title">Quick Start</div>
        <div class="service-card__subtitle">First export</div>
        <div class="service-card__body">Walk through a minimal Rhino/Grasshopper model and export it to WUFI-Passive or PHPP.</div>
      </a>

      <a class="service-card" href="https://docs.passivehousetools.com/honeybee-ph/" target="_blank">
        <div class="service-card__title">Docs</div>
        <div class="service-card__subtitle">API reference</div>
        <div class="service-card__body">Reference docs for the Honeybee-PH Python libraries and Grasshopper components.</div>
      </a>

      <a class="service-card" href="/honeybee-ph/resources/">
        <div class="service-card__title">Resources</div>
        <div class="service-card__subtitle">Courses &amp; tutorials</div>
        <div class="service-card__body">Video courses, recorded talks, and step-by-step tutorials.</div>
      </a>
    </div>
  </section>

  <!-- Component Repos -->
  <section class="projects">
    <h2>Repositories</h2>
    <p class="section-desc">The open-source repositories behind Honeybee-PH.</p>
    <div class="card-grid">
      <a class="service-card" href="https://github.com/PH-Tools/honeybee_ph" target="_blank">
        <div class="service-card__title">honeybee_ph</div>
        <div class="service-card__subtitle">Python data model</div>
        <div class="service-card__body">Extends Ladybug Tools with Passive House attributes for WUFI-Passive and PHPP.</div>
      </a>
      <a class="service-card" href="https://github.com/PH-Tools/PHX" target="_blank">
        <div class="service-card__title">PHX</div>
        <div class="service-card__subtitle">Serialization engine</div>
        <div class="service-card__body">Converts models between Honeybee-PH, WUFI-Passive XML, and PHPP Excel.</div>
      </a>
      <a class="service-card" href="https://github.com/PH-Tools/honeybee_grasshopper_ph" target="_blank">
        <div class="service-card__title">honeybee_grasshopper_ph</div>
        <div class="service-card__subtitle">Grasshopper components</div>
        <div class="service-card__body">Grasshopper components for building and exporting Passive House models.</div>
      </a>
      <a class="service-card" href="https://github.com/PH-Tools/honeybee_grasshopper_ph_plus" target="_blank">
        <div class="service-card__title">honeybee_grasshopper_ph_plus</div>
        <div class="service-card__subtitle">Extended components</div>
        <div class="service-card__body">Extra Grasshopper components for reporting and advanced workflows.</div>
      </a>
    </div>
  </section>
</BaseLayout>
